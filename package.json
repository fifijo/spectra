{
  "name": "spectra-test-automation",
  "version": "0.1.0",
  "description": "Full-spectrum test automation using AI agents with Playwright",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "spectra": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "templates",
    "specs",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:seed": "playwright test tests/seed.spec.ts",
    "report": "playwright show-report .spectra/output/reports",
    "spectra": "node dist/bin.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run check && pnpm run typecheck && pnpm run typecheck:test && pnpm run test:unit && pnpm run build && changeset publish"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "automation",
    "ai-agents",
    "test-generation",
    "self-healing",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fifijo/spectra.git"
  },
  "homepage": "https://github.com/fifijo/spectra#readme",
  "bugs": {
    "url": "https://github.com/fifijo/spectra/issues"
  },
  "pnpm": {
    "overrides": {
      "read-yaml-file>js-yaml": "3.15.2",
      "@changesets/parse>js-yaml": "4.3.2",
      "source-map-js": "^1.2.2"
    }
  }
}
